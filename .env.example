# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# For Docker Compose: host must be "postgres" (the service name), not localhost.
# For local dev:      use localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tattoo_assistant

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Generate a strong random value — must be at least 32 characters.
# Example:  openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-random-32-char-string
JWT_ALGORITHM=HS256

# ─────────────────────────────────────────────
# AZURE OPENAI  (shared endpoint + key)
# ─────────────────────────────────────────────
# Found at: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>

# ── GPT-4o  (chat + vision) ─────────────────
# Deployment name: Azure OpenAI Studio → Deployments → your GPT-4o deployment
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# API version for GPT-4o chat completions.
# Check the latest at: https://learn.microsoft.com/azure/ai-services/openai/api-version-deprecation
AZURE_OPENAI_CHAT_API_VERSION=2025-01-01-preview

# ── gpt-image-1  (image generation) ─────────
# Deployment name: Azure OpenAI Studio → Deployments → your gpt-image-1 deployment
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
# gpt-image-1 requires a later API version than the chat model.
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# Max tokens the chat model may output per response (default: 2048)
# Increase to 4096 if you need longer detailed responses.
AZURE_OPENAI_MAX_TOKENS=2048

# ─────────────────────────────────────────────
# AZURE SPEECH SERVICES
# ─────────────────────────────────────────────
# Found at: Azure Portal → your Speech resource → Keys and Endpoint
AZURE_SPEECH_KEY=<your-speech-key>

# Choose ONE of the two options below:

# Option A — Standard regional routing (most common)
# Use the short region code shown in the portal, e.g.  eastus  westeurope  southeastasia
AZURE_SPEECH_REGION=eastus

# Option B — Custom / private endpoint URL
# Use this if the portal shows a full URL like:
#   https://<name>.cognitiveservices.azure.com/
# or if you have a private endpoint configured.
# Leave blank if you are using Option A.
AZURE_SPEECH_ENDPOINT=

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
# The backend URL as seen by the user's browser.
# Docker Compose:  http://localhost:8000
# Production:      https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
